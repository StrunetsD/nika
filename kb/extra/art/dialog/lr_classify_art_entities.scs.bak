if_what_is_genre = [*
	_message
		_<- concept_message;
		_<= nrel_sc_text_translation:: .._tr_genre;;
	@link_genre = _[Что такое Жанр?];;
	.._tr_genre -> @link_genre;;
*];;

then_what_is_genre = [*
	concept_message_about_entity _-> _message;;
	_message _-> rrel_entity:: concept_genre;;
*];;

lr_classify_what_is_genre
<- concept_classify_message_rule_priority_1;
<- rrel_main_key_sc_element: (if_what_is_genre => then_what_is_genre)
	(* <- nrel_implication;; *);;

atomic_logical_formula
-> if_what_is_genre;
-> then_what_is_genre;;

concept_template_with_links
-> if_what_is_genre;;

