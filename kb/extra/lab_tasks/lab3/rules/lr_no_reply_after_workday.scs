// Лаб. 3, задача 3 — логическое правило.
// «Если сообщение пришло после того, как рабочий день закончился,
//  ответа на сообщение не будет.»

if_message_after_workday = [*
	_message _<- concept_message;;
	_message _=> nrel_arrival_moment:: _arrival;;
	_workday _=> nrel_workday_end_moment:: _workday_end;;
	_arrival _=> nrel_later_than:: _workday_end;;
*];;

then_no_reply = [*
	_message _<- concept_message_without_reply;;
*];;

lr_no_reply_after_workday
=> nrel_main_idtf:
	[Если сообщение пришло после окончания рабочего дня, ответа не будет]
	(* <- lang_ru;; *);
<- rrel_main_key_sc_element: (if_message_after_workday => then_no_reply)
	(* <- nrel_implication;; *);;

atomic_logical_formula
-> if_message_after_workday;
-> then_no_reply;;
