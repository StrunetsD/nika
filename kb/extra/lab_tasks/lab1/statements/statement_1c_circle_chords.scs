// Лаб. 1, задача 1в — фактографическое высказывание.
// «Продолжения хорд AB и CD окружности с диаметром AD пересекаются под углом 25°.
//  Найдите острый угол между хордами AC и BD.»

point_A
<- concept_point;
=> nrel_main_idtf: [A] (* <- lang_ru;; *);;

point_B
<- concept_point;
=> nrel_main_idtf: [B] (* <- lang_ru;; *);;

point_C
<- concept_point;
=> nrel_main_idtf: [C] (* <- lang_ru;; *);;

point_D
<- concept_point;
=> nrel_main_idtf: [D] (* <- lang_ru;; *);;

circle_omega
<- concept_circle;
=> nrel_main_idtf:
	[окружность ω]
	(* <- lang_ru;; *);;

diameter_AD
<- concept_diameter;
=> nrel_main_idtf:
	[диаметр AD]
	(* <- lang_ru;; *);
=> nrel_belongs_to_circle: circle_omega;
-> rrel_1: point_A;
-> rrel_2: point_D;;

chord_AB
<- concept_chord;
=> nrel_main_idtf:
	[хорда AB]
	(* <- lang_ru;; *);
=> nrel_belongs_to_circle: circle_omega;
-> rrel_1: point_A;
-> rrel_2: point_B;;

chord_CD
<- concept_chord;
=> nrel_main_idtf:
	[хорда CD]
	(* <- lang_ru;; *);
=> nrel_belongs_to_circle: circle_omega;
-> rrel_1: point_C;
-> rrel_2: point_D;;

chord_AC
<- concept_chord;
=> nrel_main_idtf:
	[хорда AC]
	(* <- lang_ru;; *);
=> nrel_belongs_to_circle: circle_omega;
-> rrel_1: point_A;
-> rrel_2: point_C;;

chord_BD
<- concept_chord;
=> nrel_main_idtf:
	[хорда BD]
	(* <- lang_ru;; *);
=> nrel_belongs_to_circle: circle_omega;
-> rrel_1: point_B;
-> rrel_2: point_D;;

extension_AB
=> nrel_main_idtf:
	[продолжение хорды AB]
	(* <- lang_ru;; *);
<= nrel_extension: chord_AB;;

extension_CD
=> nrel_main_idtf:
	[продолжение хорды CD]
	(* <- lang_ru;; *);
<= nrel_extension: chord_CD;;

point_P
<- concept_point;
=> nrel_main_idtf:
	[точка P]
	(* <- lang_ru;; *);;

extension_AB => nrel_intersection: extension_CD;;

angle_extensions
<- concept_angle;
=> nrel_main_idtf:
	[угол между продолжениями хорд AB и CD]
	(* <- lang_ru;; *);
=> nrel_formed_at_intersection: point_P;
=> nrel_degree_measure: [25];;

angle_chords_acute
<- concept_angle;
=> nrel_main_idtf:
	[острый угол между хордами AC и BD]
	(* <- lang_ru;; *);
=> nrel_acute_angle_between: chord_AC;
=> nrel_acute_angle_between: chord_BD;;

statement_1c_circle_chords
<- concept_factographic_statement;
=> nrel_main_idtf:
	[Продолжения хорд AB и CD окружности с диаметром AD пересекаются под углом 25°. Найти острый угол между AC и BD]
	(* <- lang_ru;; *);
=> nrel_note:
	[Дано: окружность с диаметром AD; хорды AB и CD; продолжения пересекаются под углом 25°. Найти острый угол между хордами AC и BD.]
	(* <- lang_ru;; *);
-> circle_omega;
-> diameter_AD;
-> chord_AB;
-> chord_CD;
-> chord_AC;
-> chord_BD;
-> extension_AB;
-> extension_CD;
-> point_P;
-> angle_extensions;
-> angle_chords_acute;;
