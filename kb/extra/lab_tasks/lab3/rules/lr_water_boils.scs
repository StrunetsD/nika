// Лаб. 3, задача 2 — логическое правило.
// «Если температура воды не меньше 100 градусов по Цельсию, вода закипает.»

if_water_temperature = [*
	_water _<- concept_water;;
	_water _=> nrel_temperature_celsius:: _temperature;;
	_temperature _=> nrel_not_less:: [100];;
*];;

then_water_boils = [*
	_water _<- concept_boiling_water;;
*];;

lr_water_boils
=> nrel_main_idtf:
	[Если температура воды не меньше 100 °C, вода закипает]
	(* <- lang_ru;; *);
<- rrel_main_key_sc_element: (if_water_temperature => then_water_boils)
	(* <- nrel_implication;; *);;

atomic_logical_formula
-> if_water_temperature;
-> then_water_boils;;
