// Лаб. 1, задача 1б — фактографическое высказывание.
// «Разность двух углов, образованных при пересечении двух прямых, равна 240.
//  Найдите меньший из этих углов.»
// «240» в методичке трактуем как 24°.

line_a
<- concept_line;
=> nrel_main_idtf:
	[прямая a]
	(* <- lang_ru;; *);;

line_b
<- concept_line;
=> nrel_main_idtf:
	[прямая b]
	(* <- lang_ru;; *);;

point_o
<- concept_point;
=> nrel_main_idtf:
	[точка O]
	(* <- lang_ru;; *);;

line_a => nrel_intersection: line_b;;

angle_alpha
<- concept_angle;
=> nrel_main_idtf:
	[угол α]
	(* <- lang_ru;; *);
=> nrel_formed_at_intersection: point_o;;

angle_beta
<- concept_angle;
=> nrel_main_idtf:
	[угол β]
	(* <- lang_ru;; *);
=> nrel_formed_at_intersection: point_o;;

angle_alpha => nrel_difference: angle_beta
	(* => nrel_degree_measure: [24];; *);;

angle_smaller
<- concept_angle;
=> nrel_main_idtf:
	[меньший из углов α и β]
	(* <- lang_ru;; *);
=> nrel_degree_measure: [78];
=> nrel_note:
	[При смежных углах: α + β = 180°, |α − β| = 24° ⇒ меньший = 78°.]
	(* <- lang_ru;; *);;

statement_1b_angles_difference
<- concept_factographic_statement;
=> nrel_main_idtf:
	[Разность двух углов при пересечении двух прямых равна 24°. Найти меньший угол]
	(* <- lang_ru;; *);
=> nrel_note:
	[Прямые a и b пересекаются в O; углы α и β образованы при пересечении; разность градусных мер равна 24°; меньший угол равен 78°.]
	(* <- lang_ru;; *);
-> line_a;
-> line_b;
-> point_o;
-> angle_alpha;
-> angle_beta;
-> angle_smaller;;
